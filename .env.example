# ============================================================================
# BF Flow — variáveis de ambiente (exemplo)
#
# Copie os valores reais para as variáveis do ambiente de deploy (ex.: Vercel →
# Settings → Environment Variables) e, para desenvolvimento local, para um
# arquivo .env.local (que é ignorado pelo git — nunca comite segredos).
#
# Convenção:
#   VITE_*  -> expostas ao navegador (bundle do cliente). Nunca coloque segredo aqui.
#   demais  -> apenas server-side (server functions / *.server.ts). Podem ser segredo.
# ============================================================================

# --- Supabase (obrigatório) -------------------------------------------------
# URL do projeto e chave publishable/anon (pública — pode ir no cliente).
VITE_SUPABASE_URL="https://SEU_PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_PROJECT_ID="seu_project_ref"

# Mesmos valores, lidos no servidor.
SUPABASE_URL="https://SEU_PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_PROJECT_ID="seu_project_ref"

# SEGREDO (service_role) — necessário para operações administrativas de usuários
# (tela "Usuários e permissões"). Ignora RLS: use SOMENTE server-side, NUNCA em
# variável VITE_*. Obtenha em: Supabase → Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY="sb_service_role_secret_xxx"

# --- Modo demonstração (opcional) -------------------------------------------
# Habilita o "Testar localmente sem login" fora de DEV. Em DEV já vem ativo.
# VITE_ENABLE_DEMO_MODE="true"

# --- Integrações opcionais (server-side) ------------------------------------
# Conexão direta ao Postgres, se usada por scripts/ferramentas.
# DATABASE_URL="postgres://usuario:senha@host:5432/postgres"

# Integração com SharePoint (upload de documentos), se habilitada.
# SHAREPOINT_GATEWAY_URL="https://..."
# SHAREPOINT_API_KEY="..."

# Stripe (cobrança), se habilitada.
# STRIPE_SECRET_KEY="sk_live_ou_test_xxx"
