<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_MercadoInterno_REV02" targetNamespace="http://bomfuturo.com.br/bpmn/mercado-interno" exporter="OpenAI" exporterVersion="2.0">
  <bpmn:collaboration id="Collaboration_MI">
    <bpmn:participant id="Participant_Cliente" name="CLIENTE" processRef="Process_Cliente" />
    <bpmn:participant id="Participant_BF" name="MERCADO INTERNO - AS IS" processRef="Process_BF" />
    <bpmn:messageFlow id="MF_NotaCliente" name="Nota fiscal de venda" sourceRef="Task_FaturarCliente" targetRef="Start_Cliente" />
    <bpmn:messageFlow id="MF_PagamentoCliente" name="Pagamento" sourceRef="Task_ClientePagar" targetRef="Sub_RecebimentoFinanceiro" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Cliente" name="CLIENTE" isExecutable="false">
    <bpmn:startEvent id="Start_Cliente" name="Receber nota fiscal de venda">
      <bpmn:messageEventDefinition id="MsgDef_NotaCliente" />
    </bpmn:startEvent>
    <bpmn:manualTask id="Task_ClientePagar" name="Realizar pagamento" />
    <bpmn:endEvent id="End_Cliente" name="Participação concluída" />
    <bpmn:sequenceFlow id="CF01" sourceRef="Start_Cliente" targetRef="Task_ClientePagar" />
    <bpmn:sequenceFlow id="CF02" sourceRef="Task_ClientePagar" targetRef="End_Cliente" />
  </bpmn:process>
  <bpmn:process id="Process_BF" name="MERCADO INTERNO" isExecutable="false">
    <bpmn:laneSet id="LaneSet_BF">
      <bpmn:lane id="Lane_Financeiro" name="FINANCEIRO">
        <bpmn:flowNodeRef>Sub_RecebimentoFinanceiro</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Comercial" name="COMERCIAL">
        <bpmn:flowNodeRef>Start_BF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CadastrarContrato</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReservarLotes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Tackup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AcompanharSaldo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_BF</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tackup" name="A DEFINIR">
        <bpmn:flowNodeRef>Task_TackupQualidade</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Operacional" name="A DEFINIR">
        <bpmn:flowNodeRef>Task_PrepararInstrucao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GerarTransferencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AceitarTransferencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FaturarCliente</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_BF" name="Contrato-pai a cadastrar" />
    <bpmn:userTask id="Task_CadastrarContrato" name="Cadastrar contrato e projeções financeiras">
      <bpmn:documentation>O Comercial cadastra o contrato-pai no ERP TOTVS Protheus, identifica a operação como Mercado Interno e registra as projeções financeiras. No exemplo demonstrado, a moeda utilizada no faturamento é real.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReservarLotes" name="Reservar lotes destinados ao contrato">
      <bpmn:documentation>O Comercial registra as reservas vinculadas ao contrato e aos lotes destinados ao atendimento, mantendo referência do contrato-pai, cliente, filial de origem, blocos, quantidades e preço contratual.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Tackup" name="Há tackup aplicável ao atendimento?" />
    <bpmn:userTask id="Task_TackupQualidade" name="Executar tackup e tratar qualidade dos lotes">
      <bpmn:documentation>Quando aplicável, os lotes passam pelo tackup e pelo tratamento das informações de qualidade, incluindo ágios e deságios. O levantamento não confirmou que essa etapa seja obrigatória em todos os contratos de Mercado Interno nem confirmou formalmente a área responsável.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PrepararInstrucao" name="Preparar instrução dos lotes">
      <bpmn:documentation>Na rotina demonstrada, é preparada uma instrução na unidade, relacionando cliente, safra, quantidade de fardos, reservas, blocos e os contratos utilizados na movimentação. O executante formal não foi confirmado.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_GerarTransferencia" name="Gerar romaneio, pedido e nota de transferência">
      <bpmn:documentation>É gerado o romaneio da algodoeira para a produtora, informando contrato de transferência, quantidade de fardos, instrução, blocos e dados logísticos. A rotina gera pedido e nota fiscal de transferência. Essa movimentação transfere saldo/estoque entre unidades e não gera financeiro.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AceitarTransferencia" name="Aceitar transferência na produtora">
      <bpmn:documentation>Na produtora, o documento transferido é localizado e aceito, gerando a nota de entrada correspondente e alterando o status do documento para aceito.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_FaturarCliente" name="Gerar pedido e nota fiscal de venda ao cliente">
      <bpmn:documentation>Após o aceite da transferência, é executada a rotina de envio ao cliente. A rotina utiliza os documentos de origem e o contrato de destino para gerar novo pedido e nova nota fiscal para o cliente. Diferentemente da transferência interna, essa operação gera financeiro.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:subProcess id="Sub_RecebimentoFinanceiro" name="Processar recebimento e conciliação financeira">
      <bpmn:documentation>Subprocesso detalhado em RECEBIMENTO E CONCILIAÇÃO FINANCEIRA. No Mercado Interno, o levantamento financeiro indicou tratamento com RA lançado diretamente pelo Financeiro, sem PR como regra, e possibilidade de compensação direta quando a nota fiscal já está emitida.</bpmn:documentation>
    </bpmn:subProcess>
    <bpmn:userTask id="Task_AcompanharSaldo" name="Acompanhar saldo e encerrar projeções">
      <bpmn:documentation>O Comercial acompanha os valores projetados, faturados, recebidos e ainda pendentes. Quando identificado saldo que não será realizado, ajusta a projeção para encerramento do valor esperado do contrato.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:endEvent id="End_BF" name="Contrato atendido e recebimento tratado" />
    <bpmn:sequenceFlow id="F01" sourceRef="Start_BF" targetRef="Task_CadastrarContrato" />
    <bpmn:sequenceFlow id="F02" sourceRef="Task_CadastrarContrato" targetRef="Task_ReservarLotes" />
    <bpmn:sequenceFlow id="F03" sourceRef="Task_ReservarLotes" targetRef="Gw_Tackup" />
    <bpmn:sequenceFlow id="F04A" sourceRef="Gw_Tackup" targetRef="Task_TackupQualidade" name="SIM" />
    <bpmn:sequenceFlow id="F05A" sourceRef="Task_TackupQualidade" targetRef="Task_PrepararInstrucao" />
    <bpmn:sequenceFlow id="F04B" sourceRef="Gw_Tackup" targetRef="Task_PrepararInstrucao" name="NÃO / NÃO APLICÁVEL" />
    <bpmn:sequenceFlow id="F06" sourceRef="Task_PrepararInstrucao" targetRef="Task_GerarTransferencia" />
    <bpmn:sequenceFlow id="F07" sourceRef="Task_GerarTransferencia" targetRef="Task_AceitarTransferencia" />
    <bpmn:sequenceFlow id="F08" sourceRef="Task_AceitarTransferencia" targetRef="Task_FaturarCliente" />
    <bpmn:sequenceFlow id="F09" sourceRef="Task_FaturarCliente" targetRef="Sub_RecebimentoFinanceiro" />
    <bpmn:sequenceFlow id="F10" sourceRef="Sub_RecebimentoFinanceiro" targetRef="Task_AcompanharSaldo" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_AcompanharSaldo" targetRef="End_BF" />
    <bpmn:textAnnotation id="N_Contrato">
      <bpmn:text>REGRA DO PROCESSO: o tipo da operação é definido no cadastro do contrato-pai como MERCADO INTERNO.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A_N_Contrato" sourceRef="Task_CadastrarContrato" targetRef="N_Contrato" />
    <bpmn:textAnnotation id="N_Moeda">
      <bpmn:text>PARTICULARIDADE: no exemplo apresentado para Mercado Interno, a moeda utilizada no faturamento é REAL.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A_N_Moeda" sourceRef="Task_CadastrarContrato" targetRef="N_Moeda" />
    <bpmn:textAnnotation id="N_Tackup">
      <bpmn:text>LACUNA / RESPONSÁVEL A DEFINIR: o levantamento mostrou reserva e referências ao tackup, mas não confirmou sua obrigatoriedade em todos os contratos de Mercado Interno nem a área formal executora.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A_N_Tackup" sourceRef="Gw_Tackup" targetRef="N_Tackup" />
    <bpmn:textAnnotation id="N_Instrucao">
      <bpmn:text>CONTROLE ATUAL / OPORTUNIDADE: na instrução demonstrada, os blocos precisam ser selecionados individualmente. Foi citado desenvolvimento para permitir informar a reserva e preencher os blocos automaticamente.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A_N_Instrucao" sourceRef="Task_PrepararInstrucao" targetRef="N_Instrucao" />
    <bpmn:textAnnotation id="N_Transferencia">
      <bpmn:text>REGRA DO PROCESSO: a transferência entre unidades movimenta estoque, mas NÃO GERA FINANCEIRO.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A_N_Transferencia" sourceRef="Task_GerarTransferencia" targetRef="N_Transferencia" />
    <bpmn:textAnnotation id="N_ResponsavelOperacional">
      <bpmn:text>RESPONSÁVEL A DEFINIR: a execução foi demonstrada por usuários da algodoeira e da produtora, mas o nome formal da área/cargo responsável não foi confirmado.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A_N_ResponsavelOperacional" sourceRef="Task_AceitarTransferencia" targetRef="N_ResponsavelOperacional" />
    <bpmn:textAnnotation id="N_VendaCliente">
      <bpmn:text>REGRA DO PROCESSO: a venda ao cliente gera NOVO PEDIDO E NOVA NOTA FISCAL e, diferente da transferência interna, GERA FINANCEIRO.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A_N_VendaCliente" sourceRef="Task_FaturarCliente" targetRef="N_VendaCliente" />
    <bpmn:textAnnotation id="N_SemExportacao">
      <bpmn:text>PARTICULARIDADE DO MERCADO INTERNO: após o faturamento ao cliente não há invoice de exportação, certificadora de pesagem nem despachante aduaneiro.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A_N_SemExportacao" sourceRef="Task_FaturarCliente" targetRef="N_SemExportacao" />
    <bpmn:textAnnotation id="N_Financeiro">
      <bpmn:text>PARTICULARIDADE FINANCEIRA: para recebimentos internos, foi relatado lançamento de RA diretamente pelo Financeiro, sem PR como regra. Quando a nota já existe, a compensação pode ocorrer diretamente contra ela.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A_N_Financeiro" sourceRef="Sub_RecebimentoFinanceiro" targetRef="N_Financeiro" />
    <bpmn:textAnnotation id="N_Saldo">
      <bpmn:text>CONTROLE DO CONTRATO: o Comercial acompanha projeção, faturamento, recebimento e saldos pendentes até o encerramento.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A_N_Saldo" sourceRef="Task_AcompanharSaldo" targetRef="N_Saldo" />
  </bpmn:process>
