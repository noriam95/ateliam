  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_1" name="MERCADO INTERNO — teste sintético" processRef="Process_1" />
    <bpmn:participant id="Pool_2" name="Cliente" />
    <bpmn:messageFlow id="Message_1" sourceRef="User_1" targetRef="Pool_2" name="Retorno" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" name="MERCADO INTERNO" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="COMERCIAL"><bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef><bpmn:flowNodeRef>Manual_1</bpmn:flowNodeRef><bpmn:flowNodeRef>Exclusive_1</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_2" name="ANALISTA"><bpmn:flowNodeRef>User_1</bpmn:flowNodeRef><bpmn:flowNodeRef>Parallel_1</bpmn:flowNodeRef><bpmn:flowNodeRef>Intermediate_1</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_3" name="EXPEDIÇÃO"><bpmn:flowNodeRef>Sub_1</bpmn:flowNodeRef><bpmn:flowNodeRef>End_1</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Pedido"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:manualTask id="Manual_1" name="Conferir pedido" vendor:review="required"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="Exclusive_1" name="Aprovado?"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="User_1" name="Analisar crédito"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:userTask>
    <bpmn:parallelGateway id="Parallel_1"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:intermediateCatchEvent id="Intermediate_1" name="Aguardar"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing><bpmn:timerEventDefinition id="Timer_1" /></bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="Sub_1" name="Expedir"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing><bpmn:startEvent id="Sub_Start" /></bpmn:subProcess>
    <bpmn:endEvent id="End_1" name="Entregue"><bpmn:incoming>Flow_7</bpmn:incoming></bpmn:endEvent>
    <bpmn:textAnnotation id="Note_1"><bpmn:text>Conferência manual antes da análise.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_1" sourceRef="Manual_1" targetRef="Note_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Manual_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Manual_1" targetRef="Exclusive_1" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Exclusive_1" targetRef="User_1" name="Sim" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="User_1" targetRef="Parallel_1" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Parallel_1" targetRef="Intermediate_1" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Intermediate_1" targetRef="Sub_1" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Sub_1" targetRef="End_1" />
  </bpmn:process>
